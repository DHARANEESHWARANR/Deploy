{
    "manifest_version": 3,
    "name": "Tab Collector",
    "version": "1.0",
    "permissions": [
      "tabs",
      "storage",
      "scripting",
      "activeTab",
      "windows"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "host_permissions": [
      "<all_urls>"
    ],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }
  